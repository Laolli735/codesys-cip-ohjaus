                      </initialValue>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Tilatiedot ja prosessimittaukset (SCADA / OPC UA lukee)</xhtml>
                      </documentation>
                    </variable>
                    <variable name="Step_Name">
                      <type>
                        <string length="40" />
                      </type>
                      <initialValue>
                        <simpleValue value="'IDLE (Valmiustila)'" />
                      </initialValue>
                    </variable>
                    <variable name="Temperature_C">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="20" />
                      </initialValue>
                    </variable>
                    <variable name="Conductivity_mScm">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="0.5" />
                      </initialValue>
                    </variable>
                    <variable name="Pump_Running">
                      <type>
                        <BOOL />
                      </type>
                      <initialValue>
                        <simpleValue value="FALSE" />
                      </initialValue>
                    </variable>
                    <variable name="Caustic_Valve_Open">
                      <type>
                        <BOOL />
                      </type>
                      <initialValue>
                        <simpleValue value="FALSE" />
                      </initialValue>
                    </variable>
                    <variable name="tonStepTimer">
                      <type>
                        <derived name="TON" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Sisäiset ajastimet ja syklilaskurit</xhtml>
                      </documentation>
                    </variable>
                    <variable name="tonCycleTick">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="bTick500ms">
                      <type>
                        <BOOL />
                      </type>
                      <initialValue>
                        <simpleValue value="FALSE" />
                      </initialValue>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// 500 ms simulaatiopulssi prosessiarvojen (lämpö ja johtokyky) päivittämiseen
tonCycleTick(IN := NOT tonCycleTick.Q, PT := T#500MS);
bTick500ms := tonCycleTick.Q;

// Turvalukitus (Hardwired / Safety E-Stop ohittaa kaiken)
IF Cmd_EStop THEN
    Step_ID := 99;
    Step_Name := 'ALARM / E-STOP';
    Pump_Running := FALSE;
    Caustic_Valve_Open := FALSE;
    Cmd_Start := FALSE;
    tonStepTimer(IN := FALSE);
    RETURN;
END_IF

// Palautuminen hälytyksestä kun E-Stop kuitataan pois
IF (Step_ID = 99) AND NOT Cmd_EStop THEN
    Step_ID := 0;
    Step_Name := 'IDLE (Valmiustila)';
END_IF

// Päätilakone (ISA-88 / IEC 61131-3)
CASE Step_ID OF

    0: // IDLE (Valmiustila)
        Pump_Running := FALSE;
        Caustic_Valve_Open := FALSE;
        tonStepTimer(IN := FALSE);

        IF bTick500ms THEN
            Temperature_C := MAX(20.0, Temperature_C - 1.5);
            Conductivity_mScm := MAX(0.5, Conductivity_mScm - 1.0);
        END_IF

        IF Cmd_Start THEN
            Cmd_Start := FALSE; // Nollataan käynnistyspulssi
            Step_ID := 1;
            Step_Name := 'PRE_RINSE (Esihuuhtelu)';
        END_IF

    1: // PRE_RINSE (Esihuuhtelu vedellä 3 sekuntia)
        Pump_Running := TRUE;
        Caustic_Valve_Open := FALSE;
        tonStepTimer(IN := TRUE, PT := T#3S);

        IF bTick500ms THEN
            Temperature_C := MIN(40.0, Temperature_C + 4.0);
            Conductivity_mScm := 1.2;
        END_IF

        IF tonStepTimer.Q THEN
            tonStepTimer(IN := FALSE);
            Step_ID := 2;
            Step_Name := 'CAUSTIC_WASH (Lipeapesu 75C)';
        END_IF

    2: // CAUSTIC_WASH (Lipeäpesu: lämmitys 75C + kemikaali)
        Pump_Running := TRUE;
        Caustic_Valve_Open := TRUE;
        tonStepTimer(IN := TRUE, PT := T#4S);

        IF bTick500ms THEN
            Temperature_C := MIN(75.0, Temperature_C + 7.0);
            Conductivity_mScm := MIN(45.0, Conductivity_mScm + 9.0);
        END_IF

        IF tonStepTimer.Q AND (Temperature_C &gt;= 70.0) THEN
            tonStepTimer(IN := FALSE);
            Step_ID := 3;
            Step_Name := 'FINAL_RINSE (Loppuhuuhtelu)';
        END_IF

    3: // FINAL_RINSE (Loppuhuuhtelu kunnes johtokyky &lt;= 2.0 mS/cm)
        Pump_Running := TRUE;
        Caustic_Valve_Open := FALSE;
        tonStepTimer(IN := FALSE);

        IF bTick500ms THEN
            Temperature_C := MAX(25.0, Temperature_C - 8.0);
            Conductivity_mScm := MAX(0.8, Conductivity_mScm - 9.0);
        END_IF

        IF Conductivity_mScm &lt;= 2.0 THEN
            Step_ID := 0;
            Step_Name := 'IDLE (Valmiustila)';
        END_IF

END_CASE</xhtml>
                  </ST>
                </body>
